{
  "$schema": "https://raw.githubusercontent.com/wsl-images/wslb/main/schemas/wslb-workspace.schema.json",
  "name": "WSLB Managed VHDX",
  "image": "ubuntu:24.04",
  "features": {
    "wslb:feature/wsl-prereqs": {},
    "ghcr.io/devcontainers/features/common-utils:2": {}
  },
  "remoteUser": "dev",
  "wslb": {
    "distroName": "ManagedVHDX",
    "managed": true,
    "oobe": {
      "mode": "predefined",
      "strategy": "hybrid",
      "promptForPassword": true
    },
    "state": {
      "mode": "vhdx",
      "path": "./state/managed-vhdx.vhdx",
      "mountPoint": "/home",
      "fsLabel": "WSLB_STATE"
    },
    "wslconf": {
      "boot": {
        "systemd": true
      },
      "automount": {
        "enabled": true,
        "mountFsTab": true,
        "options": "metadata"
      }
    },
    "distribution": {
      "shortcut": {
        "enabled": true,
        "icon": {
          "simpleIcon": "ubuntu",
          "color": "E95420",
          "style": "flat"
        }
      },
      "windowsterminal": {
        "enabled": true
      }
    }
  }
}


