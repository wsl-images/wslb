{
  "$schema": "https://raw.githubusercontent.com/wsl-images/wslb/main/schemas/wslb-workspace.schema.json",
  "name": "WSLB Minimal",
  "image": "ubuntu:24.04",
  "features": {
    "wslb:feature/wsl-prereqs": {},
    "ghcr.io/devcontainers/features/common-utils:2": {}
  },
  "remoteUser": "dev",
  "wslb": {
    "distroName": "UbuntuMinimal",
    "managed": false,
    "oobe": {
      "mode": "predefined",
      "strategy": "wslb-only",
      "promptForPassword": false
    },
    "wslconf": {
      "boot": {
        "systemd": true
      },
      "automount": {
        "enabled": true,
        "mountFsTab": true
      }
    },
    "distribution": {
      "shortcut": {
        "enabled": true,
        "icon": {
          "simpleIcon": "ubuntu",
          "color": "E95420",
          "style": "flat"
        }
      },
      "windowsterminal": {
        "enabled": true
      }
    }
  }
}

